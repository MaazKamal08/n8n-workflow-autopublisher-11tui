      "parameters": {
        "jsCode": "const raw =\n  $input.first().json.content?.parts?.[0]?.text ||\n  $input.first().json.text ||\n  $input.first().json.output ||\n  '';\n\nconst cleaned = raw\n  .replace(/^\\s*```json\\s*/i, '')\n  .replace(/^\\s*```\\s*/i, '')\n  .replace(/\\s*```\\s*$/i, '')\n  .trim();\n\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Gemini output is not valid JSON: ' + e.message + '\\n\\nRaw output preview:\\n' + cleaned.slice(0, 1500));\n}\n\nreturn [{ json: data }];"
      },

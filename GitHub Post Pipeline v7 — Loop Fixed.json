    {
      "parameters": {
        "jsCode": "// ─── SAFE SHEET READ ───────────────────────────────────────────────\n// Google Sheets node throws or returns a single empty-keyed item when\n// the sheet has no data rows. We normalise that to an empty array and\n// attach the Drive file list so the next node has everything it needs.\n\n// Collect processed IDs from sheet (empty-safe)\nconst sheetItems = $input.all();\nconst processedIds = new Set(\n  sheetItems\n    .map(i => i.json.file_id)\n    .filter(v => v && typeof v === 'string' && v.trim() !== '')\n);\n\n// All files from Drive (previous node)\nconst driveFiles = $('List Drive Folder').all();\n\n// Filter to only .json files not yet processed\nconst newFiles = driveFiles.filter(f => {\n  const name = (f.json.name || '').trim();\n  return name.toLowerCase().endsWith('.json') && !processedIds.has(f.json.id);\n});\n\nif (newFiles.length === 0) {\n  // Return a sentinel — downstream IF will stop the run cleanly\n  return [{ json: { hasNewFiles: false, totalNew: 0 } }];\n}\n\n// Tag every item so IF node can check the flag\nreturn newFiles.map(f => ({\n  json: {\n    hasNewFiles: true,\n    totalNew: newFiles.length,\n    id:   f.json.id,\n    name: f.json.name\n  }\n}));"
      },

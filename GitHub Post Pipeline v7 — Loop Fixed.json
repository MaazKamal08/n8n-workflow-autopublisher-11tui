      "parameters": {
        "jsCode": "const repo = $input.first().json;\nconst docs = $('Build README + SETUP').first().json;\n\n// ── Markdown strings ──────────────────────────────────────────────────────────\nconst readmeStr = typeof docs.readme === 'string'\n  ? docs.readme\n  : JSON.stringify(docs.readme || '', null, 2);\n\nconst setupStr = typeof docs.setupGuide === 'string'\n  ? docs.setupGuide\n  : JSON.stringify(docs.setupGuide || '', null, 2);\n\n// ── Base64 encode here so HTTP nodes receive plain strings ────────────────────\nconst readmeBase64 = Buffer.from(readmeStr,  'utf8').toString('base64');\nconst setupBase64  = Buffer.from(setupStr,   'utf8').toString('base64');\n\n// ── Workflow JSON base64 ──────────────────────────────────────────────────────\nconst wfStr = typeof docs.workflowContent === 'string'\n  ? docs.workflowContent\n  : JSON.stringify(docs.workflowContent || {}, null, 2);\nconst workflowBase64 = Buffer.from(wfStr, 'utf8').toString('base64');\n\nreturn [{\n  json: {\n    owner:            repo.owner?.login,\n    repoName:         repo.name,\n    repoDescription:  repo.description,\n    repoUrl:          repo.html_url,\n    defaultBranch:    repo.default_branch || 'main',\n\n    fileName:         docs.fileName,\n    fileId:           docs.fileId,\n    workflowContent:  wfStr,\n\n    readmeContent:    readmeStr,\n    setupGuideContent: setupStr,\n\n    readmeBase64,\n    setupBase64,\n    workflowBase64\n  }\n}];\n"
      },

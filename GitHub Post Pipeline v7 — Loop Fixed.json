        2480
      ],
      "id": "cd479f93-7ba8-4fc2-843b-b34c9510e620",
      "name": "Message a model",
      "retryOnFail": true,
      "credentials": {
        "googlePalmApi": {
          "id": "OS9NDfkI8EazVspe",
          "name": "Njmarketings2 Gemini API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\n\nconst clean = (value, fallback = 'n8n-workflow') => String(value || fallback)\n  .toLowerCase()\n  .replace(/[^a-z0-9-_]/g, '-')\n  .replace(/-+/g, '-')\n  .replace(/^-|-$/g, '')\n  .slice(0, 90);\n\nconst baseRepoName = clean(d.repoName || d.sourceRepoName || d.fileName || 'n8n-workflow');\nconst suffix = d.fileId ? '-' + String(d.fileId).slice(0, 5).toLowerCase().replace(/[^a-z0-9]/g, '') : '';\nconst repoName = (baseRepoName + suffix).replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 100);\n\nconst list = (items = []) => {\n  if (!Array.isArray(items) || items.length === 0) return '- Not specified';\n  return items.map(i => `- ${String(i).replace(/\\n/g, ' ')}`).join('\\n');\n};\n\nconst numbered = (items = []) => {\n  if (!Array.isArray(items) || items.length === 0) return '1. Not specified';\n  return items.map((i, index) => `${index + 1}. ${String(i).replace(/\\n/g, ' ')}`).join('\\n');\n};\n\nconst readme = `# ${repoName}\n\n## Overview\n\n${d.overview || d.mainPurpose || 'This repository contains an n8n automation workflow.'}\n\n## Features\n\n${list(d.features)}\n\n## Services Used\n\n${list(d.servicesUsed)}\n\n## Trigger\n\n${d.trigger || 'Not specified'}\n\n## Prerequisites\n\n${list(d.prerequisites)}\n\n## Credentials\n\n${list(d.credentials)}\n\n## Configuration\n\n${numbered(d.configurationSteps)}\n\n## Usage\n\n${numbered(d.usageSteps)}\n\n## Troubleshooting\n\n${list(d.troubleshooting)}\n\n## Security Notes\n\n${list(d.securityNotes)}\n`;\n\nconst setupGuide = `# Setup Guide\n\n## 1. Prerequisites\n\n${list(d.prerequisites)}\n\n## 2. Configure Credentials\n\n${list(d.credentials)}\n\n## 3. Configure Workflow\n\n${numbered(d.configurationSteps)}\n\n## 4. Test Workflow\n\n${numbered(d.usageSteps)}\n\n## 5. Troubleshooting\n\n${list(d.troubleshooting)}\n\n## 6. Production Security\n\n${list(d.securityNotes)}\n`;\n\nreturn [{\n  json: {\n    ...d,\n    repoName,\n    repoDescription: String(d.repoDescription || 'n8n automation workflow').slice(0, 120),\n    readme,\n    setupGuide,\n    readmeContent: readme,\n    setupGuideContent: setupGuide\n  }\n}];"
      },

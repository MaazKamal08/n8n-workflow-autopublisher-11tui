        "messages": {
          "values": [
            {
              "content": "=You are a senior n8n workflow analyst.\n\nAnalyze this n8n workflow JSON:\n\n{{ $json.workflowContent }}\n\nReturn ONLY valid JSON.\nNo markdown fences.\nNo explanation.\nNo multiline markdown strings.\nNo code blocks.\nNo unescaped quotes.\n\nReturn exactly this structure:\n\n{\n  \"repoName\": \"short-clean-repo-name\",\n  \"repoDescription\": \"one sentence under 120 characters\",\n  \"overview\": \"short overview paragraph\",\n  \"features\": [\"feature 1\", \"feature 2\", \"feature 3\"],\n  \"prerequisites\": [\"requirement 1\", \"requirement 2\"],\n  \"credentials\": [\"credential 1\", \"credential 2\"],\n  \"configurationSteps\": [\"step 1\", \"step 2\", \"step 3\"],\n  \"usageSteps\": [\"step 1\", \"step 2\", \"step 3\"],\n  \"troubleshooting\": [\"issue 1\", \"issue 2\"],\n  \"securityNotes\": [\"note 1\", \"note 2\"],\n  \"servicesUsed\": [\"service 1\", \"service 2\"],\n  \"trigger\": \"how the workflow starts\",\n  \"mainPurpose\": \"what the workflow does\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [

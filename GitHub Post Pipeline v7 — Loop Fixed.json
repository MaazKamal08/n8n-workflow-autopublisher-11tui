    {
      "parameters": {
        "jsCode": "const binaryPropertyName = Object.keys($input.first().binary || {})[0];\n\nif (!binaryPropertyName) {\n  throw new Error('No binary file found from Google Drive Download node');\n}\n\n// Original file metadata comes from the Split node, not from the binary download output.\nconst currentFile = $('Split — One File at a Time').first().json;\nconst fileId = currentFile.id;\nconst fileName = currentFile.name;\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryPropertyName);\nlet workflowContent = buffer.toString('utf8');\n\ntry {\n  workflowContent = JSON.stringify(JSON.parse(workflowContent), null, 2);\n} catch (e) {\n  // Keep original text if it is not valid JSON.\n}\n\nconst sourceRepoName = fileName\n  .replace(/\\.json$/i, '')\n  .replace(/[()\\[\\]]/g, '')\n  .replace(/[_\\s]+/g, '-')\n  .replace(/[^a-zA-Z0-9-]/g, '')\n  .replace(/-+/g, '-')\n  .replace(/^-|-$/g, '')\n  .toLowerCase()\n  .slice(0, 80);\n\nreturn [{\n  json: {\n    fileId,\n    fileName,\n    sourceRepoName,\n    workflowContent\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
